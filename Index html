<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ebook Store — Preview</title>

<style>
  :root {
    --bg: #0a0a0a;
    --bg-elevated: #171717;
    --border: #262626;
    --text: #f5f5f5;
    --text-muted: #a3a3a3;
    --text-dim: #737373;
    --accent: #ef4444;
    --accent-hover: #f87171;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  /* =========================================================
     2D PARTICLE BACKGROUND
     ========================================================= */

  #particle-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    display: block;
  }

  /*
    Soft overlay keeps the particle background subtle
    while preserving readability.
  */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;

    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(239, 68, 68, 0.08),
        transparent 30%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(153, 27, 27, 0.07),
        transparent 35%
      );
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* =========================================================
     NAVIGATION
     ========================================================= */

  nav {
    position: sticky;
    top: 0;
    z-index: 20;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 20px 24px;

    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-bottom: 1px solid var(--border);
  }

  nav .logo {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav .logo span {
    color: var(--accent);
  }

  nav .links {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: var(--text-muted);
  }

  nav .links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav .links a:hover {
    color: var(--text);
  }

  nav .cta {
    background: var(--accent);
    color: #0a0a0a;
    border: none;

    padding: 8px 16px;
    border-radius: 6px;

    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  nav .cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  /* =========================================================
     PROMO SLIDER
     ========================================================= */

  .slider {
    position: relative;
    overflow: hidden;
    height: 220px;
  }

  @media (min-width: 860px) {
    .slider {
      height: 280px;
    }
  }

  .slider-track {
    display: flex;
    height: 100%;
    transition: transform 0.5s ease;
  }

  .slide {
    min-width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    padding: 0 24px;
  }

  @media (min-width: 860px) {
    .slide {
      padding: 0 64px;
    }
  }

  .slide h3 {
    font-size: 1.4rem;
    margin: 0 0 8px;
  }

  .slide p {
    margin: 0 0 16px;
    color: rgba(245, 245, 245, 0.8);
    max-width: 420px;
    font-size: 14px;
  }

  .slide-cta {
    background: #0a0a0a;
    color: #fff;

    padding: 8px 18px;
    border-radius: 6px;

    text-decoration: none;
    font-size: 13px;
    font-weight: 600;

    width: fit-content;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .slide-cta:hover {
    transform: translateY(-2px);
    background: #171717;
  }

  .slider-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);

    display: flex;
    gap: 8px;
  }

  .slider-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);

    border: none;
    cursor: pointer;
    padding: 0;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .slider-dot:hover {
    transform: scale(1.35);
  }

  .slider-dot.active {
    background: #fff;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    background: rgba(0, 0, 0, 0.35);
    border: none;

    color: #fff;

    width: 34px;
    height: 34px;

    border-radius: 50%;

    cursor: pointer;
    font-size: 16px;
    line-height: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 5;

    transition: background 0.2s ease;
  }

  .slider-arrow.prev {
    left: 12px;
  }

  .slider-arrow.next {
    right: 12px;
  }

  .slider-arrow:hover {
    background: rgba(0, 0, 0, 0.65);
  }

  /* =========================================================
     HERO
     ========================================================= */

  .hero-spacer {
    height: 130vh;
    position: relative;
  }

  .hero-sticky {
    position: sticky;
    top: 0;

    height: 100vh;

    display: grid;
    grid-template-columns: 1fr;

    align-items: center;

    padding: 0 24px;
    gap: 32px;
  }

  @media (min-width: 860px) {
    .hero-sticky {
      grid-template-columns: 1fr 1fr;
      padding: 0 64px;
    }
  }

  .eyebrow {
    color: var(--accent);

    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;

    margin-bottom: 16px;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.75rem);
    line-height: 1.05;

    font-weight: 600;

    margin: 0;

    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: 24px;

    color: var(--text-muted);

    max-width: 420px;

    line-height: 1.6;
    font-size: 15px;
  }

  .browse-btn {
    display: inline-block;

    margin-top: 32px;

    background: var(--accent);
    color: #0a0a0a;

    font-weight: 600;

    padding: 12px 24px;
    border-radius: 6px;

    text-decoration: none;
    border: none;

    cursor: pointer;
    font-size: 15px;

    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .browse-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.18);
  }

  .hint {
    margin-top: 14px;

    font-size: 12px;
    color: var(--text-dim);
  }

  /* =========================================================
     THREE.JS BOOK
     ========================================================= */

  .canvas-wrap {
    height: 55vh;
    min-height: 320px;

    cursor: pointer;
    position: relative;
  }

  @media (min-width: 860px) {
    .canvas-wrap {
      height: 70vh;
    }
  }

  #three-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* =========================================================
     CATALOG
     ========================================================= */

  section.catalog {
    max-width: 1100px;

    margin: 0 auto;

    padding: 80px 24px 40px;
  }

  section.catalog h2 {
    font-size: 1.5rem;
    margin-bottom: 24px;
  }

  .grid {
    display: grid;

    grid-template-columns:
      repeat(auto-fill, minmax(180px, 1fr));

    gap: 20px;
  }

  .card {
    background: rgba(23, 23, 23, 0.88);

    border: 1px solid var(--border);
    border-radius: 10px;

    padding: 16px;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-5px);

    border-color: #3a3a3a;

    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.25),
      0 0 25px rgba(239, 68, 68, 0.04);
  }

  .cover {
    aspect-ratio: 3 / 4;

    border-radius: 6px;

    margin-bottom: 12px;

    background:
      linear-gradient(
        135deg,
        var(--accent),
        #991b1b
      );

    transition: transform 0.2s ease;
  }

  .card:hover .cover {
    transform: scale(1.015);
  }

  .card h3 {
    font-size: 14px;
    margin: 0 0 4px;
  }

  .card p {
    font-size: 13px;
    color: var(--text-dim);
    margin: 0;
  }

  /* =========================================================
     FOOTER
     ========================================================= */

  footer {
    border-top: 1px solid var(--border);

    padding: 40px 24px;

    display: flex;
    flex-wrap: wrap;

    gap: 24px;

    font-size: 13px;
    color: var(--text-dim);
  }

  footer a {
    color: inherit;
    text-decoration: none;

    transition: color 0.2s ease;
  }

  footer a:hover {
    color: var(--text-muted);
  }

  /* =========================================================
     COOKIE BANNER
     ========================================================= */

  .banner {
    position: fixed;

    bottom: 0;
    left: 0;
    right: 0;

    background: rgba(23, 23, 23, 0.94);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-top: 1px solid var(--border);

    padding: 16px 24px;

    display: flex;
    flex-wrap: wrap;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    font-size: 13px;
    color: var(--text-muted);

    z-index: 30;
  }

  .banner button {
    background: var(--accent);
    color: #0a0a0a;

    border: none;

    padding: 8px 16px;

    border-radius: 6px;

    font-weight: 600;
    cursor: pointer;

    flex-shrink: 0;

    transition: background 0.2s ease;
  }

  .banner button:hover {
    background: var(--accent-hover);
  }

  /* =========================================================
     RESPONSIVE NAVIGATION
     ========================================================= */

  @media (max-width: 600px) {
    nav {
      padding: 16px;
    }

    nav .links {
      gap: 12px;
      font-size: 12px;
    }

    nav .cta {
      padding: 7px 12px;
      font-size: 12px;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    #particle-bg {
      display: none;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
</head>

