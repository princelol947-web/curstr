<!-- =========================================================
     2D PARTICLE BACKGROUND ANIMATION
     ========================================================= -->

<script>

(function () {

  const canvas =
    document.getElementById('particle-bg');

  const ctx =
    canvas.getContext('2d');

  let particles = [];

  let width = 0;
  let height = 0;

  let dpr =
    Math.min(window.devicePixelRatio || 1, 2);

  let mouseX = -9999;
  let mouseY = -9999;


  /* ---------------------------------------------------------
     CONFIGURATION
     --------------------------------------------------------- */

  const CONFIG = {

    // Maximum number of particles.
    maxParticles: 110,

    // Minimum number on small screens.
    minParticles: 45,

    // Distance at which particles connect.
    connectionDistance: 105,

    // Distance at which mouse interaction begins.
    mouseDistance: 150,

    // Base movement speed.
    speed: 0.28

  };


  /* ---------------------------------------------------------
     CREATE PARTICLES
     --------------------------------------------------------- */

  function createParticles() {

    const calculatedCount =
      Math.floor(
        (width * height) / 15000
      );

    const count =
      Math.min(
        CONFIG.maxParticles,
        Math.max(
          CONFIG.minParticles,
          calculatedCount
        )
      );


    particles =
      Array.from(
        { length: count },
        () => ({

          x: Math.random() * width,

          y: Math.random() * height,

          vx:
            (Math.random() - 0.5) *
            CONFIG.speed,

          vy:
            (Math.random() - 0.5) *
            CONFIG.speed,

          r:
            Math.random() * 1.6 + 0.5,

          phase:
            Math.random() *
            Math.PI *
            2

        })
      );

  }


  /* ---------------------------------------------------------
     RESIZE CANVAS
     --------------------------------------------------------- */

  function resize() {

    width =
      window.innerWidth;

    height =
      window.innerHeight;

    dpr =
      Math.min(
        window.devicePixelRatio || 1,
        2
      );


    canvas.width =
      Math.floor(width * dpr);

    canvas.height =
      Math.floor(height * dpr);


    canvas.style.width =
      width + 'px';

    canvas.style.height =
      height + 'px';


    ctx.setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );


    createParticles();

  }


  /* ---------------------------------------------------------
     MOUSE / TOUCH POSITION
     --------------------------------------------------------- */

  window.addEventListener(
    'pointermove',
    event => {

      mouseX =
        event.clientX;

      mouseY =
        event.clientY;

    },
    {
      passive: true
    }
  );


  window.addEventListener(
    'pointerleave',
    () => {

      mouseX = -9999;
      mouseY = -9999;

    },
    {
      passive: true
    }
  );


  /* ---------------------------------------------------------
     ANIMATION
     --------------------------------------------------------- */

  function animateParticles(time) {

    requestAnimationFrame(
      animateParticles
    );


    ctx.clearRect(
      0,
      0,
      width,
      height
    );


    const seconds =
      time * 0.001;


    /* -------------------------------------------------------
       UPDATE + DRAW PARTICLES
       ------------------------------------------------------- */

    for (const p of particles) {

      /*
        Normal floating movement.
      */

      p.x += p.vx;
      p.y += p.vy;


      /*
        Wrap particles around screen edges.
      */

      if (p.x < -10)
        p.x = width + 10;

      if (p.x > width + 10)
        p.x = -10;

      if (p.y < -10)
        p.y = height + 10;

      if (p.y > height + 10)
        p.y = -10;


      /*
        Mouse attraction.

        The closer the mouse is,
        the stronger the effect.
      */

      const dx =
        mouseX - p.x;

      const dy =
        mouseY - p.y;

      const distance =
        Math.hypot(dx, dy);


      if (
        distance <
          CONFIG.mouseDistance &&
        distance > 1
      ) {

        const force =
          (1 -
            distance /
            CONFIG.mouseDistance) *
          0.012;


        p.vx +=
          dx * force;

        p.vy +=
          dy * force;

      }


      /*
        Slowly reduce velocity so the
        particles remain smooth.
      */

      p.vx *= 0.995;
      p.vy *= 0.995;


      /*
        Gentle pulsing opacity.
      */

      const pulse =
        0.65 +
        Math.sin(
          seconds * 1.5 +
          p.phase
        ) *
        0.25;


      /*
        Draw particle.
      */

      ctx.beginPath();

      ctx.arc(
        p.x,
        p.y,
        p.r,
        0,
        Math.PI * 2
      );


      ctx.fillStyle =
        `rgba(
          239,
          68,
          68,
          ${Math.max(0.18, pulse)}
        )`;


      ctx.fill();

    }


    /* -------------------------------------------------------
       CONNECT NEARBY PARTICLES
       ------------------------------------------------------- */

    for (
      let i = 0;
      i < particles.length;
      i++
    ) {

      for (
        let j = i + 1;
        j < particles.length;
        j++
      ) {

        const a =
          particles[i];

        const b =
          particles[j];


        const dx =
          a.x - b.x;

        const dy =
          a.y - b.y;

        const distance =
          Math.hypot(dx, dy);


        if (
          distance <
          CONFIG.connectionDistance
        ) {

          const alpha =
            (1 -
              distance /
              CONFIG.connectionDistance) *
            0.12;


          ctx.beginPath();

          ctx.moveTo(
            a.x,
            a.y
          );

          ctx.lineTo(
            b.x,
            b.y
          );


          ctx.strokeStyle =
            `rgba(
              239,
              68,
              68,
              ${alpha}
            )`;


          ctx.lineWidth =
            0.7;

          ctx.stroke();

        }

      }

    }

  }


  /* ---------------------------------------------------------
     START
     --------------------------------------------------------- */

  window.addEventListener(
    'resize',
    resize,
    {
      passive: true
    }
  );


  resize();

  requestAnimationFrame(
    animateParticles
  );

})();

</script>


<!-- =========================================================
     THREE.JS BOOK ANIMATION
     ========================================================= -->

<script>

  // Floating "book" that rotates on scroll
  // and pulses when clicked.

  const canvas =
    document.getElementById(
      'three-canvas'
    );

  const wrap =
    document.getElementById(
      'canvasWrap'
    );


  /* ---------------------------------------------------------
     RENDERER
     --------------------------------------------------------- */

  const renderer =
    new THREE.WebGLRenderer({

      canvas,

      antialias: true,

      alpha: true

    });


  /* ---------------------------------------------------------
     SCENE
     --------------------------------------------------------- */

  const scene =
    new THREE.Scene();


  /* ---------------------------------------------------------
     CAMERA
     --------------------------------------------------------- */

  const camera =
    new THREE.PerspectiveCamera(
      45,
      1,
      0.1,
      100
    );


  camera.position.set(
    0,
    0,
    4.5
  );


  /* ---------------------------------------------------------
     LIGHTING
     --------------------------------------------------------- */

  const ambient =
    new THREE.AmbientLight(
      0xffffff,
      0.7
    );


  const dir =
    new THREE.DirectionalLight(
      0xffffff,
      1.2
    );


  dir.position.set(
    3,
    3,
    3
  );


  scene.add(
    ambient,
    dir
  );


  /* ---------------------------------------------------------
     BOOK
     --------------------------------------------------------- */

  const geometry =
    new THREE.BoxGeometry(
      1.4,
      2,
      0.15
    );


  const material =
    new THREE.MeshStandardMaterial({

      color: 0xef4444,

      metalness: 0.3,

      roughness: 0.4

    });


  const book =
    new THREE.Mesh(
      geometry,
      material
    );


  scene.add(book);


  /* ---------------------------------------------------------
     RESIZE
     --------------------------------------------------------- */

  function resizeBook() {

    const w =
      wrap.clientWidth;

    const h =
      wrap.clientHeight;


    renderer.setSize(
      w,
      h,
      false
    );


    camera.aspect =
      w / h;


    camera.updateProjectionMatrix();

  }


  window.addEventListener(
    'resize',
    resizeBook
  );


  resizeBook();


  /* ---------------------------------------------------------
     SCROLL PROGRESS
     --------------------------------------------------------- */

  let scrollProgress = 0;


  function updateScrollProgress() {

    const spacer =
      document.getElementById(
        'heroSpacer'
      );


    const rect =
      spacer.getBoundingClientRect();


    const total =
      rect.height +
      window.innerHeight;


    let p =
      (
        window.innerHeight -
        rect.top
      ) /
      total;


    p =
      Math.min(
        Math.max(p, 0),
        1
      );


    scrollProgress = p;

  }


  window.addEventListener(
    'scroll',
    updateScrollProgress,
    {
      passive: true
    }
  );


  updateScrollProgress();


  /* ---------------------------------------------------------
     CLICK PULSE
     --------------------------------------------------------- */

  let targetScale = 1;
  let currentScale = 1;


  wrap.addEventListener(
    'click',
    () => {

      targetScale = 1.15;


      setTimeout(
        () => {
          targetScale = 1;
        },
        250
      );

    }
  );


  /* ---------------------------------------------------------
     BOOK ANIMATION
     --------------------------------------------------------- */

  let floatT = 0;


  function animateBook() {

    requestAnimationFrame(
      animateBook
    );


    floatT += 0.015;


    /*
      Rotate based on page scroll.
    */

    book.rotation.y =
      scrollProgress *
      Math.PI *
      2;


    book.rotation.x =
      Math.sin(
        scrollProgress *
        Math.PI
      ) *
      0.3;


    /*
      Gentle floating motion.
    */

    book.position.y =
      Math.sin(floatT) *
      0.08;


    /*
      Smooth click scaling.
    */

    currentScale +=
      (
        targetScale -
        currentScale
      ) *
      0.15;


    book.scale.set(
      currentScale,
      currentScale,
      currentScale
    );


    renderer.render(
      scene,
      camera
    );

  }


  animateBook();

</script>


<!-- =========================================================
     PROMO SLIDER SCRIPT
     ========================================================= -->

<script>

(function () {

  const track =
    document.getElementById(
      'sliderTrack'
    );


  const dotsWrap =
    document.getElementById(
      'sliderDots'
    );


  const total =
    track.children.length;


  let index = 0;

  let autoTimer;


  /* ---------------------------------------------------------
     CREATE DOTS
     --------------------------------------------------------- */

  for (
    let i = 0;
    i < total;
    i++
  ) {

    const dot =
      document.createElement(
        'button'
      );


    dot.className =
      'slider-dot' +
      (
        i === 0
          ? ' active'
          : ''
      );


    dot.setAttribute(
      'aria-label',
      'Go to banner ' +
      (i + 1)
    );


    dot.addEventListener(
      'click',
      () => goTo(i)
    );


    dotsWrap.appendChild(
      dot
    );

  }


  /* ---------------------------------------------------------
     GO TO SLIDE
     --------------------------------------------------------- */

  function goTo(i) {

    index =
      (i + total) %
      total;


    track.style.transform =
      `translateX(-${index * 100}%)`;


    [
      ...dotsWrap.children
    ].forEach(
      (dot, dotIndex) => {

        dot.classList.toggle(
          'active',
          dotIndex === index
        );

      }
    );


    resetAuto();

  }


  /* ---------------------------------------------------------
     NEXT / PREVIOUS
     --------------------------------------------------------- */

  function next() {

    goTo(
      index + 1
    );

  }


  function prev() {

    goTo(
      index - 1
    );

  }


  document
    .getElementById(
      'nextSlide'
    )
    .addEventListener(
      'click',
      next
    );


  document
    .getElementById(
      'prevSlide'
    )
    .addEventListener(
      'click',
      prev
    );


  /* ---------------------------------------------------------
     AUTO PLAY
     --------------------------------------------------------- */

  function resetAuto() {

    clearInterval(
      autoTimer
    );


    autoTimer =
      setInterval(
        next,
        4500
      );

  }


  resetAuto();


  /* ---------------------------------------------------------
     MOBILE SWIPE
     --------------------------------------------------------- */

  let startX = 0;


  track.addEventListener(
    'touchstart',
    event => {

      startX =
        event.touches[0].clientX;

    },
    {
      passive: true
    }
  );


  track.addEventListener(
    'touchend',
    event => {

      const diff =
        event.changedTouches[0].clientX -
        startX;


      if (diff > 40) {

        prev();

      }
      else if (diff < -40) {

        next();

      }

    },
    {
      passive: true
    }
  );


  /* ---------------------------------------------------------
     PAUSE AUTO PLAY ON HOVER
     --------------------------------------------------------- */

  const sliderSection =
    document.getElementById(
      'slider'
    );


  sliderSection.addEventListener(
    'mouseenter',
    () => clearInterval(autoTimer)
  );


  sliderSection.addEventListener(
    'mouseleave',
    resetAuto
  );

})();

</script>

